pipeline {
    agent any

    environment {
        APP_DIR = 'MeasureApp'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build APK (Docker, Android SDK image)') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$WORKSPACE":/project \
                      -w /project/$APP_DIR \
                      mingc/android-build-box:latest \
                      bash -c "
                        set -e
                        echo '=== Setting up Gradle 8.6 ==='
                        if [ ! -d /opt/gradle-8.6 ]; then
                          curl -sSL https://services.gradle.org/distributions/gradle-8.6-bin.zip -o /tmp/gradle-8.6.zip
                          unzip -q /tmp/gradle-8.6.zip -d /opt
                          rm /tmp/gradle-8.6.zip
                        fi

                        echo '=== Configuring AndroidX properties ==='
                        touch gradle.properties
                        echo 'android.useAndroidX=true' >> gradle.properties
                        echo 'android.enableJetifier=true' >> gradle.properties

                        echo '=== Building Android APK ==='
                        /opt/gradle-8.6/bin/gradle assembleDebug --no-daemon
                      "
                '''
            }
        }

        stage('Package APK into Nginx download image') {
            steps {
                sh '''
                    set -e
                    echo '=== Preparing APK for Nginx Docker Image ==='
                    
                    # apk அடைவுகளை உருவாக்கி APK-வை அங்கே நகலெடுத்தல்
                    mkdir -p $APP_DIR/apk
                    mkdir -p $APP_DIR/docker-serve/apk
                    cp $APP_DIR/app/build/outputs/apk/debug/app-debug.apk $APP_DIR/apk/
                    cp $APP_DIR/app/build/outputs/apk/debug/app-debug.apk $APP_DIR/docker-serve/apk/

                    # Nginx Dockerfile பில்ட் செய்தல்
                    if [ -f "$APP_DIR/docker-serve/Dockerfile" ]; then
                        docker build -t measurement-download:latest -f $APP_DIR/docker-serve/Dockerfile $APP_DIR
                    else
                        docker build -t measurement-download:latest - <<EOF
FROM nginx:alpine
COPY $APP_DIR/app/build/outputs/apk/debug/app-debug.apk /usr/share/nginx/html/app-debug.apk
RUN echo '<h1>MeasureApp Download</h1><p><a href="app-debug.apk">Download APK</a></p>' > /usr/share/nginx/html/index.html
EXPOSE 80
EOF
                    fi
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                archiveArtifacts artifacts: "${APP_DIR}/app/build/outputs/apk/debug/*.apk", allowEmptyArchive: true
            }
        }

        stage('Push to Quay.io') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    echo 'Quay.io push step (Configure credentials if needed)'
                }
            }
        }

        stage('Deploy to OpenShift') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    echo 'OpenShift deploy step (Configure token if needed)'
                }
            }
        }
    }

    post {
        success {
            echo 'Build, APK Generation, and Packaging succeeded without errors!'
        }
        failure {
            echo 'Build encountered an issue. Check the logs above.'
        }
    }
}
